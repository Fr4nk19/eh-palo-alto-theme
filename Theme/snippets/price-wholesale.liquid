{% comment %}
    Renders a product price con ajuste wholesale

    Reglas wholesale:
    - Base = compare_at_price si hay oferta; en otro caso base = price
    - wholesale = base * (100 - settings.wholesale_discount_percent)/100
    - Se muestra el wholesale como precio principal y el base retail tachado
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign namespace = namespace | default: ''

  if namespace == ''
    assign price_class = 'product-grid-item__price-new'
    assign unit_class = 'product__unit-price'
  else
    assign price_class = namespace | append: '__price-new'
    assign unit_class = namespace | append: '__unit-price'
  endif

  assign product_price_value = product.price
  assign product_price_min_value = product.price_min
  assign product_compare_at_price = product.compare_at_price
  assign product_unit_price_min_value = ''

  assign on_sale = false
  if product_compare_at_price > product_price_value
    assign on_sale = true
  endif

  if current_variant.requires_selling_plan and product.selling_plan_groups.size > 0
    assign product_compare_at_price = current_variant.selling_plan_allocations[0].compare_at_price
  endif

  if product.requires_selling_plan and product.selling_plan_groups.size > 0
    assign product_price_value = current_variant.selling_plan_allocations[0].per_delivery_price

    if product.price_varies
      for variant in product.variants
        if variant.selling_plan_allocations[0].per_delivery_price < product_price_min_value
          assign product_price_min_value = variant.selling_plan_allocations[0].per_delivery_price
          assign product_unit_price_min_value = variant.unit_price
        endif
      endfor
    endif
  endif

  if product.price_varies and product.requires_selling_plan == false
    assign product_unit_price_min_value = current_variant.unit_price
  endif
-%}

  {%- comment -%} -------------------- WHOLESALE LOGIC -------------------- {%- endcomment -%}
  {% assign wholesale_percent = settings.wholesale_discount_percent | default: 0 | plus: 0 %}

  {% if wholesale_percent > 0 %}
    {%- comment -%}
      Calculamos factor entero para evitar floats: discount_factor = 100 - wholesale_percent
      Base:
        - Si on_sale → usar compare_at (precio de lista retail)
        - Si no hay oferta → usar price (precio retail actual)
    {%- endcomment -%}
    {% assign discount_factor = 100 | minus: wholesale_percent %}

    {% assign wholesale_base_value = product_price_value %}
    {% if on_sale and product_compare_at_price > 0 %}
      {% assign wholesale_base_value = product_compare_at_price %}
    {% endif %}

    {%- comment -%} Precio wholesale del "precio principal" {%- endcomment -%}
    {% assign wholesale_price_value = wholesale_base_value | times: discount_factor | divided_by: 100 %}

    {%- comment -%}
      Para colecciones con precios variables, calculamos el mínimo wholesale
      recorriendo variantes (usando el mismo criterio de base por variante).
    {%- endcomment -%}
    {% if product.price_varies %}
      {% assign wholesale_min = blank %}
      {% for v in product.variants %}
        {% assign v_base = v.price %}
        {% if v.compare_at_price > v.price %}
          {% assign v_base = v.compare_at_price %}
        {% endif %}
        {% assign v_wholesale = v_base | times: discount_factor | divided_by: 100 %}

        {% if wholesale_min == blank or v_wholesale < wholesale_min %}
          {% assign wholesale_min = v_wholesale %}
          {% assign product_unit_price_min_value = v.unit_price %}
        {% endif %}
      {% endfor %}
      {% assign product_price_min_value = wholesale_min | default: product_price_min_value %}
    {% endif %}

    {%- comment -%}
      Sobrescribimos para que el render muestre:
      - Precio principal = wholesale
      - Tachado = base retail (price o compare_at según haya oferta)
      Forzamos on_sale para que se muestre <s> aunque no tuviera oferta retail.
    {%- endcomment -%}
    {% assign product_price_value = wholesale_price_value %}
    {% assign product_compare_at_price = wholesale_base_value %}
    {% assign on_sale = true %}
  {% endif %}
  {%- comment -%} ------------------ /WHOLESALE LOGIC ------------------ {%- endcomment -%}

  {%- if product_price_value == 0 and product.price_varies == false -%}
    {% assign product_price = 'products.product.free' | t %}
    {% assign product_price_min = 'products.product.free' | t %}
  {%- elsif settings.currency_code_enable -%}
    {% assign product_price = product_price_value | money_with_currency %}
    {% assign product_price_min = product_price_min_value | money_with_currency %}
  {%- else -%}
    {% assign product_price = product_price_value | money %}
    {% assign product_price_min = product_price_min_value | money %}
  {%- endif -%}

{%- comment -%} === BADGE WHOLESALE (solo añade este div si aplica) === {%- endcomment -%}
{% if wholesale_percent > 0 %}
  <div class="product__price--off product__price-badge-wholesale">wholesale discount</div>
{% endif %}

{%- if product.price_varies -%}
  {{- 'products.general.from_text_html' | t: price: product_price_min -}}
{%- else -%}
  {%- if on_sale -%}
    <span class="{{ price_class }}">{{ product_price }}</span>
    <s>
      {%- if settings.currency_code_enable -%}
        {{- product_compare_at_price | money_with_currency -}}
      {%- else -%}
        {{- product_compare_at_price | money -}}
      {%- endif -%}
    </s>
  {%- else -%}
    {{- product_price -}}
  {%- endif -%}
{%- endif -%}

{%- if current_variant.unit_price_measurement or product.price_varies and product_unit_price_min_value != '' -%}
  {%- capture separator_and_unit -%}
    <span aria-hidden="true">/</span><span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}&nbsp;</span>
    {% if current_variant.unit_price_measurement.reference_value != 1 %}
      {{ current_variant.unit_price_measurement.reference_value }}
    {% endif %}
    {{ current_variant.unit_price_measurement.reference_unit }}
  {%- endcapture -%}

  {%- capture unit_price -%}
    {% if product.price_varies %}
      {%- if product_unit_price_min_value != blank -%}
        {{ product_unit_price_min_value | money }}
        {{ separator_and_unit }}
      {%- endif -%}
    {% else %}
      {% if current_variant.requires_selling_plan and product.selling_plan_groups.size > 0 %}
        {{ current_variant.selling_plan_allocations[0].unit_price | money }}
      {% else %}
        {{ current_variant.unit_price | money }}
      {% endif %}
      {{ separator_and_unit }}
    {% endif %}
  {%- endcapture -%}

  {%- if unit_price != blank -%}
    <span class="{{ unit_class }}{% if current_variant.unit_price == 0 %} hidden{% endif %}">{{ unit_price }}</span>
  {%- endif -%}
{%- endif -%}
