<script>
  document.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(window.location.search);
    console.log("Params:", params);
    const hideWholesale = document.querySelectorAll(".hide-wholesale");

    // Caso A: directo en el query (?from=wholesale)
    // const fromLogin = params.get("from") === "wholesale";
    const fromLogin = params.get("from")?.includes("wholesale")
    console.log("Caso A:", fromLogin);

    // Caso B: dentro de return_url (?return_url=/account?from=wholesale)
    const returnUrl = params.get("return_url");
    console.log("Caso B:", returnUrl);
    let fromReturn = false;

    if (returnUrl) {
      const decoded = decodeURIComponent(returnUrl);
      const innerParams = new URLSearchParams(decoded.split("?")[1] || "");
      // fromReturn = innerParams.get("from") === "wholesale";
      fromReturn = innerParams.get("from")?.includes("wholesale")
      console.log("Caso B:", fromReturn);
    }

    if (fromLogin || fromReturn) {
      // Mostrar bloque especial
      document.querySelector(".wholesale-apply")?.removeAttribute("hidden");
      hideWholesale.forEach(element => element.setAttribute('hidden',''));

      const loginHeading = document.querySelector(".login-heading");
      if (loginHeading) loginHeading.textContent = "Wholesale Account Log-In";
      

      // Cambiar título principal
      // const loginHeading = document.querySelector("h1, .customer-login__title");
      // if (loginHeading) loginHeading.textContent = "Wholesale Login";
    }
  });
</script>




