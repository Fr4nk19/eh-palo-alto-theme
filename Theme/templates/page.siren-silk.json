        "rv1": { "type": "review", "settings": { "text": "I've tried The Ordinary, RoC, even prescription tretinoin. Every one wrecked my barrier. This is the first thing that made my skin look better — not worse — after the first week.", "author": "Sarah M., 38", "skin_type": "Sensitive + Rosacea-prone" } },
        "rv2": { "type": "review", "settings": { "text": "The retinol uglies are real and I've lived through them twice. Woke up with actual glow, zero flaking. Three weeks in and my fine lines look noticeably softer.", "author": "Jessica T., 43", "skin_type": "Dry + Mature skin" } },
        "rv3": { "type": "review", "settings": { "text": "My skin literally cannot tolerate retinol — contact dermatitis every time. I'd given up on anti-aging entirely. This changed that. Calm, hydrated, and real texture improvement.", "author": "Amanda K., 35", "skin_type": "Eczema-prone skin" } },
