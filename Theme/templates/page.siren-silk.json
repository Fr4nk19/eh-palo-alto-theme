        "ing1": { "type": "ingredient", "settings": { "icon": "🌿", "name": "Sea Fennel", "role": "Bio-Retinol Active", "description": "Clinically shown to smooth fine lines and improve texture — by working with your skin's renewal signals, not overriding them.", "chip": "No purge. No fallout." } },
        "ing2": { "type": "ingredient", "settings": { "icon": "🌾", "name": "Colloidal Oatmeal", "role": "Barrier Support", "description": "While bio-retinol works, oatmeal holds your barrier steady. Proven to reduce redness and lock in moisture. No vulnerability window.", "chip": "No worse before better." } },
        "ing3": { "type": "ingredient", "settings": { "icon": "🌼", "name": "Chamomile · Calendula · Aloe", "role": "Triple-Calm Complex", "description": "Overnight support that settles inflammation and restores balance. By morning: hydrated and even — not tight, not reactive.", "chip": "Calm skin by morning." } },
