{% doc %}
  @prompt
    Genera una seccion para agregar dos columnas con titulo, contenido y boton al medio y el fondo de ambas columnas pueden ser o un fodo de color o una imagen.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-columns-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-two-columns__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    padding: 0 30px;
  }

  .ai-two-columns__column-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: {{ block.settings.column_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-two-columns__background-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .ai-two-columns__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});
    z-index: 1;
  }

  .ai-two-columns__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    text-align: center;
    width: 100%;
  }

  .ai-two-columns__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_spacing }}px;
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.2;
  }

  .ai-two-columns__text-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.text_spacing }}px;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-two-columns__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-two-columns__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-two-columns__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-two-columns__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-two-columns__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-two-columns-{{ ai_gen_id }} fja-update" {{ block.shopify_attributes }}>
  <div class="ai-two-columns__container-{{ ai_gen_id }}">
    <div 
      class="ai-two-columns__column-{{ ai_gen_id }} column_fja"
      style="background-color: {{ block.settings.column_1_bg_color }};"
    >
      {% if block.settings.column_1_bg_image %}
        <img
          src="{{ block.settings.column_1_bg_image | image_url: width: 1000 }}"
          alt="{{ block.settings.column_1_bg_image.alt | escape }}"
          class="ai-two-columns__background-image-{{ ai_gen_id }}"
          loading="lazy"
        >
        <div class="ai-two-columns__overlay-{{ ai_gen_id }}"></div>
      {% endif %}
      
      <div class="ai-two-columns__content-{{ ai_gen_id }}">
        {% if block.settings.column_1_title != blank %}
          <h2 
            class="ai-two-columns__title-{{ ai_gen_id }}"
            style="color: {{ block.settings.column_1_title_color }};"
          >
            {{ block.settings.column_1_title }}
          </h2>
        {% endif %}
        
        {% if block.settings.column_1_text != blank %}
          <div 
            class="ai-two-columns__text-{{ ai_gen_id }}"
            style="color: {{ block.settings.column_1_text_color }};"
          >
            {{ block.settings.column_1_text }}
          </div>
        {% endif %}
        
        {% if block.settings.column_1_button_text != blank and block.settings.column_1_button_link != blank %}
          <a 
            href="{{ block.settings.column_1_button_link }}" 
            class="ai-two-columns__button-{{ ai_gen_id }}"
          >
            {{ block.settings.column_1_button_text }}
          </a>
        {% endif %}
      </div>
    </div>

    <div 
      class="ai-two-columns__column-{{ ai_gen_id }} column_fja"
      style="background-color: {{ block.settings.column_2_bg_color }};"
    >
      {% if block.settings.column_2_bg_image %}
        <img
          src="{{ block.settings.column_2_bg_image | image_url: width: 1000 }}"
          alt="{{ block.settings.column_2_bg_image.alt | escape }}"
          class="ai-two-columns__background-image-{{ ai_gen_id }}"
          loading="lazy"
        >
        <div class="ai-two-columns__overlay-{{ ai_gen_id }}"></div>
      {% endif %}
      
      <div class="ai-two-columns__content-{{ ai_gen_id }}">
        {% if block.settings.column_2_title != blank %}
          <h2 
            class="ai-two-columns__title-{{ ai_gen_id }}"
            style="color: {{ block.settings.column_2_title_color }};"
          >
            {{ block.settings.column_2_title }}
          </h2>
        {% endif %}
        
        {% if block.settings.column_2_text != blank %}
          <div 
            class="ai-two-columns__text-{{ ai_gen_id }}"
            style="color: {{ block.settings.column_2_text_color }};"
          >
            {{ block.settings.column_2_text }}
          </div>
        {% endif %}
        
        {% if block.settings.column_2_button_text != blank and block.settings.column_2_button_link != blank %}
          <a 
            href="{{ block.settings.column_2_button_link }}" 
            class="ai-two-columns__button-{{ ai_gen_id }}"
          >
            {{ block.settings.column_2_button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

