{% doc %}
  @prompt
    crea una seccion similar a la de newsletter , con la diferencia que el form sea un form de klaviyo , solo el embeded code necesito agregar y la seccion debe tener titulo a la izquierda y formulario a la derecha 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-klaviyo-newsletter-{{ ai_gen_id }} {
    display: block;
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-klaviyo-newsletter__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-klaviyo-newsletter__content-{{ ai_gen_id }} {
    text-align: left;
  }

  .ai-klaviyo-newsletter__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
  }

  .ai-klaviyo-newsletter__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  .ai-klaviyo-newsletter__form-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-klaviyo-newsletter__embed-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-klaviyo-newsletter__empty-state-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: #f4f4f4;
    border-radius: 8px;
    text-align: center;
    color: #666;
  }

  .ai-klaviyo-newsletter__empty-state-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 12px;
    color: #333;
  }

  .ai-klaviyo-newsletter__empty-state-text-{{ ai_gen_id }} {
    font-size: 14px;
    margin: 0 0 8px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-klaviyo-newsletter-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px 20px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-klaviyo-newsletter__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.6 }}px;
    }

    .ai-klaviyo-newsletter__content-{{ ai_gen_id }} {
      text-align: center;
    }

    .ai-klaviyo-newsletter__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-klaviyo-newsletter__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<klaviyo-newsletter-{{ ai_gen_id }}
  class="ai-klaviyo-newsletter-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-klaviyo-newsletter__container-{{ ai_gen_id }}">
    <div class="ai-klaviyo-newsletter__content-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-klaviyo-newsletter__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-klaviyo-newsletter__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}
    </div>

    <div class="ai-klaviyo-newsletter__form-wrapper-{{ ai_gen_id }}">
      {% if block.settings.klaviyo_embed_code != blank %}
        <div class="ai-klaviyo-newsletter__embed-{{ ai_gen_id }}">
          {{ block.settings.klaviyo_embed_code }}
        </div>
      {% else %}
        <div class="ai-klaviyo-newsletter__empty-state-{{ ai_gen_id }}">
          <div class="ai-klaviyo-newsletter__empty-state-title-{{ ai_gen_id }}">
            Embed code de Klaviyo requerido
          </div>
          <p class="ai-klaviyo-newsletter__empty-state-text-{{ ai_gen_id }}">
            Para mostrar el formulario de newsletter de Klaviyo:
          </p>
          <p class="ai-klaviyo-newsletter__empty-state-text-{{ ai_gen_id }}">
            1. Ve a tu cuenta de Klaviyo y crea un formulario<br>
            2. Copia el código embed completo<br>
            3. Pégalo en el campo "Klaviyo embed code" en la configuración
          </p>
        </div>
      {% endif %}
    </div>
  </div>
</klaviyo-newsletter-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Newsletter Klaviyo",
  "settings": [
    {
      "type": "header",
      "content": "Configuración de Klaviyo"
    },
    {
      "type": "html",
      "id": "klaviyo_embed_code",
      "label": "Klaviyo embed code",
      "info": "Pega aquí el código embed completo de tu formulario de Klaviyo"
    },
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "default": "Suscríbete a nuestro newsletter"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "<p>Recibe las últimas novedades, ofertas exclusivas y consejos directamente en tu correo.</p>"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Ancho en desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Ancho máximo del contenedor",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Espacio entre columnas",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#fff7f2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#041010"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#041010"
    },
    {
      "type": "header",
      "content": "Tipografía"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamaño del título",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Tamaño del subtítulo",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Espacio después del título",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaciado superior",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaciado inferior",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Newsletter Klaviyo"
    }
  ]
}
{% endschema %}