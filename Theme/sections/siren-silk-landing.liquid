/* ── SOCIAL PROOF ── */
#ss-{{ sid }} .ss-social { padding: 56px 0; background: var(--ss-white); }
#ss-{{ sid }} .ss-section-head { margin-bottom: 28px; }
#ss-{{ sid }} .ss-section-head .ss-h2 { margin-top: 4px; }
