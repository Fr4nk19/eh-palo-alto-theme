  #ss-{{ sid }} .ss-hero-content { order: 1; flex: 0 0 50%; padding: 72px 52px 72px 44px; text-align: left; display: flex; flex-direction: column; justify-content: center; }
  #ss-{{ sid }} .ss-hero-img-wrap { order: 2; flex: 0 0 50%; max-height: none; }
  #ss-{{ sid }} .ss-hero-img { height: 100%; max-height: none; }
  #ss-{{ sid }} .ss-hero-sub { margin-left: 0; margin-right: 0; }
  #ss-{{ sid }} .ss-rating { justify-content: flex-start; }
  #ss-{{ sid }} .ss-trust-badges { justify-content: flex-start; }
  #ss-{{ sid }} .ss-btn { width: auto; display: inline-block; }
  #ss-{{ sid }} .ss-btn-final { display: inline-block; width: auto; }
  /* Ingredient cards: grid */
  #ss-{{ sid }} .ss-ing-scroll { display: grid; grid-template-columns: repeat(3,1fr); overflow-x: visible; margin: 0; padding: 0; }
  #ss-{{ sid }} .ss-ing-card { flex: none; max-width: none; }
  #ss-{{ sid }} .ss-scroll-dots { display: none; }
  /* Reviews: row */
  #ss-{{ sid }} .ss-reviews { flex-direction: row; }
  #ss-{{ sid }} .ss-rcard { flex: 1; }
  /* Products: row */
  #ss-{{ sid }} .ss-product-grid { flex-direction: row; }
  #ss-{{ sid }} .ss-pcard { flex: 1; }
  /* Callout with image accent */
  #ss-{{ sid }} .ss-callout { padding: 44px 40px; }
  #ss-{{ sid }} .ss-callout-img-accent { width: 140px; }
}
@media (prefers-reduced-motion: reduce) {
  #ss-{{ sid }} .ss-btn { transition: none; }
}

/* ── THEME OVERRIDE: скидаємо відступи які тема додає до обгортки ── */
.shopify-section:has(#ss-{{ sid }}) { margin: 0 !important; padding: 0 !important; }
#ss-{{ sid }} .ss-page { margin: 0; }

/* ── FIX: зменшуємо вертикальні відступи між секціями ── */
#ss-{{ sid }} .ss-validation { padding: 28px 0 32px; }
