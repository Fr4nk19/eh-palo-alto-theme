{%- comment -%}
  SIREN SILK Bio-Retinol Landing Page — Earth Harbor
  File: sections/siren-silk-landing.liquid
  Page template: templates/page.siren-silk.json
  
  All text, images, and repeatable blocks are editable
  in the Shopify Theme Customizer (Online Store → Customize).
{%- endcomment -%}

{%- liquid
  assign s            = section.settings
  assign trust_badges = section.blocks | where: 'type', 'trust_badge'
  assign ingredients  = section.blocks | where: 'type', 'ingredient'
  assign comp_rows    = section.blocks | where: 'type', 'comparison_row'
  assign reviews      = section.blocks | where: 'type', 'review'
  assign risk_items   = section.blocks | where: 'type', 'risk_proof'
  assign prod_sizes   = section.blocks | where: 'type', 'product_size'
  assign cert_tags    = section.blocks | where: 'type', 'cert_tag'
  assign sid          = section.id
-%}

<div class="ss-page" id="ss-{{ sid }}">

  <!-- ═══ ANNOUNCEMENT BAR ═══ -->
  <div class="ss-announce">{{ s.announce_text }}</div>

  <!-- ═══ ① HERO ═══ -->
  <section class="ss-hero">
    <div class="ss-hero-inner">

      <div class="ss-hero-content">
        <span class="ss-script ss-hero-brand">{{ s.hero_brand }}</span>

        <h1 class="ss-h1">
          {{ s.hero_h1_line1 }}<br>
          <em>{{ s.hero_h1_italic }}</em><br>
          {{ s.hero_h1_line3 }}
        </h1>

        <p class="ss-hero-sub">{{ s.hero_subheading }}</p>

        <div class="ss-rating">
          <div class="ss-stars">
            {%- for i in (1..5) -%}
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            {%- endfor -%}
          </div>
          <span>{{ s.hero_rating }}&nbsp;·&nbsp;<strong>{{ s.hero_review_count }} Reviews</strong></span>
        </div>

        <div class="ss-trust-badges">
          {%- for block in trust_badges -%}
            <span class="ss-tbadge" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'check' -%}<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {%- when 'lab' -%}<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                {%- when 'heart' -%}<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                {%- when 'refresh' -%}<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              {%- endcase -%}
              {{ block.settings.label }}
            </span>
          {%- endfor -%}
        </div>

        <a href="{{ s.hero_cta_url }}" class="ss-btn">{{ s.hero_cta_text }}</a>
        <p class="ss-btn-micro">{{ s.hero_cta_micro }}</p>
      </div>

      <div class="ss-hero-img-wrap">
        {%- if s.hero_image != blank -%}
          {{- s.hero_image | image_url: width: 1200 | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              class: 'ss-hero-img',
              alt: s.hero_image.alt | default: 'SIREN SILK Bio-Retinol Cream' -}}
        {%- endif -%}
      </div>

    </div>
  </section>

  <!-- ═══ ② VALIDATION + PIVOT ═══ -->
  <div class="ss-wave-dn" aria-hidden="true">
    <svg viewBox="0 0 1440 36" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0 18 Q360 0 720 18 Q1080 36 1440 18 L1440 36 L0 36 Z" fill="#F8F5F1"/></svg>
  </div>
  <section class="ss-validation">
    <div class="ss-container ss-center">
      <p class="ss-val-pain">{{ s.val_pain }}</p>
      <p class="ss-val-sub">{{ s.val_sub }}</p>
      <span class="ss-val-arrow">{{ s.val_arrow }}</span>
    </div>
  </section>
  <div class="ss-wave-up" aria-hidden="true">
    <svg viewBox="0 0 1440 36" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0 18 Q360 36 720 18 Q1080 0 1440 18 L1440 0 L0 0 Z" fill="#F8F5F1"/></svg>
  </div>

  <!-- ═══ ③ EDU + DIFFERENTIATION ═══ -->
  <section class="ss-edu">
    <div class="ss-container">

      <div class="ss-edu-header">
        <span class="ss-eyebrow">{{ s.edu_eyebrow }}</span>
        <h2 class="ss-h2">{{ s.edu_heading }}</h2>
      </div>

      <!-- CALLOUT BOX -->
      <div class="ss-callout">
        {%- if s.texture_image != blank -%}
          <div class="ss-callout-img-accent" aria-hidden="true">
            {{- s.texture_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: '', class: 'ss-texture-img' -}}
          </div>
        {%- endif -%}
        <div class="ss-callout-body">
          <span class="ss-callout-tag">{{ s.callout_tag }}</span>
          <h3 class="ss-callout-h">{{ s.callout_heading }}</h3>
          <p>{{ s.callout_body }}</p>
        </div>
      </div>

      <!-- PATHWAY COMPARISON -->
      <div class="ss-pathway-grid">
        <div class="ss-pathway ss-pathway-bad">
          <span class="ss-pathway-tag">{{ s.pathway_bad_label }}</span>
          {%- if s.pathway_bad_step1 != blank -%}<div class="ss-p-step"><span class="ss-p-dot"></span><p>{{ s.pathway_bad_step1 }}</p></div>{%- endif -%}
          {%- if s.pathway_bad_step2 != blank -%}<div class="ss-p-step"><span class="ss-p-dot"></span><p>{{ s.pathway_bad_step2 }}</p></div>{%- endif -%}
          {%- if s.pathway_bad_step3 != blank -%}<div class="ss-p-step"><span class="ss-p-dot"></span><p>{{ s.pathway_bad_step3 }}</p></div>{%- endif -%}
          {%- if s.pathway_bad_step4 != blank -%}<div class="ss-p-step"><span class="ss-p-dot"></span><p>{{ s.pathway_bad_step4 }}</p></div>{%- endif -%}
          <p class="ss-p-result">{{ s.pathway_bad_result }}</p>
        </div>
        <div class="ss-pathway ss-pathway-good">
          <span class="ss-pathway-tag">{{ s.pathway_good_label }}</span>
          {%- if s.pathway_good_step1 != blank -%}<div class="ss-p-step"><span class="ss-p-dot"></span><p>{{ s.pathway_good_step1 }}</p></div>{%- endif -%}
          {%- if s.pathway_good_step2 != blank -%}<div class="ss-p-step"><span class="ss-p-dot"></span><p>{{ s.pathway_good_step2 }}</p></div>{%- endif -%}
          {%- if s.pathway_good_step3 != blank -%}<div class="ss-p-step"><span class="ss-p-dot"></span><p>{{ s.pathway_good_step3 }}</p></div>{%- endif -%}
          {%- if s.pathway_good_step4 != blank -%}<div class="ss-p-step"><span class="ss-p-dot"></span><p>{{ s.pathway_good_step4 }}</p></div>{%- endif -%}
          <p class="ss-p-result">{{ s.pathway_good_result }}</p>
        </div>
      </div>

      <!-- INGREDIENT CARDS -->
      <span class="ss-ing-label">{{ s.ing_section_label }}</span>
      <div class="ss-ing-scroll" id="ss-ing-{{ sid }}">
        {%- for block in ingredients -%}
          <div class="ss-ing-card" {{ block.shopify_attributes }}>
            <div class="ss-ing-icon">{{ block.settings.icon }}</div>
            <p class="ss-ing-name">{{ block.settings.name }}</p>
            <span class="ss-ing-role">{{ block.settings.role }}</span>
            <p>{{ block.settings.description }}</p>
            <span class="ss-ing-chip">{{ block.settings.chip }}</span>
          </div>
        {%- endfor -%}
      </div>
      <div class="ss-scroll-dots" id="ss-dots-{{ sid }}" aria-hidden="true">
        {%- for block in ingredients -%}
          <span class="ss-sdot{% if forloop.first %} ss-sdot-on{% endif %}"></span>
        {%- endfor -%}
      </div>

      <!-- COMPARISON TABLE -->
      <div class="ss-table-wrap">
        <table class="ss-table">
          <thead>
            <tr>
              <th></th>
              <th>{{ s.table_col_retinol }}</th>
              <th class="ss-th-hl">{{ s.table_col_siren }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in comp_rows -%}
              <tr {{ block.shopify_attributes }}>
                <td class="ss-td-feat">{{ block.settings.feature }}</td>
                <td>
                  {%- if block.settings.retinol_positive -%}<span class="ss-ck">✓</span>{%- else -%}<span class="ss-cx">✗</span>{%- endif -%}
                  {{ block.settings.retinol_value }}
                </td>
                <td class="ss-td-hl"><span class="ss-ck">✓</span> {{ block.settings.siren_value }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <!-- CERT STRIP -->
      <div class="ss-cert-strip">
        <span class="ss-cert-lbl">{{ s.cert_label }}</span>
        <div class="ss-cert-tags">
          {%- for block in cert_tags -%}
            <span class="ss-ctag" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
          {%- endfor -%}
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ ④ SOCIAL PROOF ═══ -->
  <section class="ss-social">
    <div class="ss-container">
      <div class="ss-section-head ss-center">
        <span class="ss-eyebrow">{{ s.social_eyebrow }}</span>
        <h2 class="ss-h2">{{ s.social_heading }}</h2>
      </div>
      <div class="ss-reviews">
        {%- for block in reviews -%}
          <div class="ss-rcard" {{ block.shopify_attributes }}>
            <div class="ss-rcard-stars">
              {%- for i in (1..5) -%}
                <svg width="13" height="13" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {%- endfor -%}
            </div>
            <p class="ss-rcard-text">"{{ block.settings.text }}"</p>
            <p class="ss-rcard-name">{{ block.settings.author }}</p>
            <p class="ss-rcard-skin">{{ block.settings.skin_type }}</p>
            <span class="ss-rcard-v">
              <svg width="10" height="10" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Verified Purchase
            </span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- ═══ ⑤ RISK REMOVAL ═══ -->
  <section class="ss-risk">
    <div class="ss-container ss-center">
      <div class="ss-guarantee-circle">
        <svg width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      </div>
      <h2 class="ss-h2">{{ s.risk_heading }}</h2>
      <p class="ss-risk-sub">{{ s.risk_sub }}</p>
      <div class="ss-risk-proof">
        {%- for block in risk_items -%}
          <span class="ss-rproof-item" {{ block.shopify_attributes }}>
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {{ block.settings.label }}
          </span>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <!-- ═══ ⑥ OFFER ═══ -->
  <section class="ss-offer" id="ss-offer-{{ sid }}">
    <div class="ss-container">
      <div class="ss-section-head ss-center">
        <span class="ss-eyebrow">{{ s.offer_eyebrow }}</span>
        <h2 class="ss-h2">{{ s.offer_heading }}</h2>
        <p class="ss-offer-sub">{{ s.offer_sub }}</p>
      </div>
      <div class="ss-product-grid">
        {%- for block in prod_sizes -%}
          <div class="ss-pcard{% if block.settings.is_popular %} ss-pcard-pop{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.is_popular -%}
              <span class="ss-pop-badge">{{ s.popular_badge_text }}</span>
            {%- endif -%}
            {%- if block.settings.product_image != blank -%}
              <div class="ss-pcard-img">
                {{- block.settings.product_image | image_url: width: 500 | image_tag:
                    loading: 'lazy',
                    class: 'ss-pimg',
                    alt: block.settings.name -}}
              </div>
            {%- endif -%}
            <p class="ss-psize">{{ block.settings.name }}</p>
            <p class="ss-pdesc">{{ block.settings.description }}</p>
            <div class="ss-price-row">
              <span class="ss-price-lbl">{{ s.price_label_onetime }}</span>
              <span class="ss-price-amt">{{ block.settings.price_onetime }}</span>
            </div>
            <div class="ss-price-row ss-price-sub">
              <span class="ss-price-lbl">{{ s.price_label_sub }}</span>
              <div class="ss-price-right">
                <span class="ss-price-amt">{{ block.settings.price_sub }}</span>
                <span class="ss-save-chip">{{ block.settings.save_label }}</span>
              </div>
            </div>
            <a href="{{ block.settings.product_url }}" class="ss-btn ss-btn-mb">{{ block.settings.cta_onetime }}</a>
            <a href="{{ block.settings.sub_url | default: block.settings.product_url }}" class="ss-btn ss-btn-ghost">{{ block.settings.cta_sub }}</a>
          </div>
        {%- endfor -%}
      </div>
      <p class="ss-offer-note">{{ s.offer_note }}</p>
    </div>
  </section>

  <!-- ═══ ⑦ FINAL CTA ═══ -->
  <section class="ss-final">
    <div class="ss-container ss-center">
      <span class="ss-eyebrow">{{ s.final_eyebrow }}</span>
      <h2 class="ss-h2 ss-final-h">{{ s.final_heading }}</h2>
      <p class="ss-final-sub">{{ s.final_sub }}</p>
      <a href="{{ s.final_cta_url }}" class="ss-btn ss-btn-teal ss-btn-final">{{ s.final_cta_text }}</a>
      <p class="ss-final-micro">{{ s.final_micro }}</p>
    </div>
  </section>

</div>

<!-- ═══════════ STYLES ═══════════ -->
<style>
#ss-{{ sid }} {
  --ss-white:      #FFFFFF;
  --ss-cream:      #F8F5F1;
  --ss-ink:        #1C1A18;
  --ss-ink-mid:    #4A4744;
  --ss-ink-muted:  #7A7470;
  --ss-teal:       #5ABCB4;
  --ss-teal-deep:  #3D9E97;
  --ss-teal-bg:    #EDF8F7;
  --ss-coral:      #C97068;
  --ss-coral-bg:   #FDF0EF;
  --ss-coral-bdr:  #ECC5C2;
  --ss-teal-bdr:   #B8E5E2;
  --ss-border:     #E5DFD9;
  --ss-r-sm:  8px; --ss-r-md: 16px; --ss-r-lg: 24px;
  --ss-r-xl:  32px; --ss-r-full: 100px;
  --ss-font-script: 'Dancing Script', cursive;
  --ss-font-ui: 'DM Sans', system-ui, sans-serif;
  font-family: var(--ss-font-ui);
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}
/* ── RESET ── */
#ss-{{ sid }} *, #ss-{{ sid }} *::before, #ss-{{ sid }} *::after { box-sizing: border-box; margin: 0; padding: 0; }
#ss-{{ sid }} img { max-width: 100%; display: block; }
/* ── TYPE ── */
#ss-{{ sid }} .ss-h1 { font-size: clamp(2rem, 8vw, 3.5rem); font-weight: 700; line-height: 1.08; letter-spacing: -0.025em; color: var(--ss-ink); }
#ss-{{ sid }} .ss-h1 em { font-style: italic; font-weight: 300; color: var(--ss-ink-mid); }
#ss-{{ sid }} .ss-h2 { font-size: clamp(1.55rem, 4.5vw, 2.3rem); font-weight: 700; line-height: 1.15; letter-spacing: -0.018em; color: var(--ss-ink); }
#ss-{{ sid }} p { font-size: 1rem; line-height: 1.72; color: var(--ss-ink-muted); }
#ss-{{ sid }} .ss-script { font-family: var(--ss-font-script); }
#ss-{{ sid }} .ss-eyebrow { font-family: var(--ss-font-script); font-size: 1.05rem; color: var(--ss-teal); display: block; margin-bottom: 6px; }
/* ── LAYOUT ── */
#ss-{{ sid }} .ss-container { width: 100%; max-width: 480px; margin: 0 auto; padding: 0 22px; }
#ss-{{ sid }} .ss-center { text-align: center; }
/* ── ANNOUNCE ── */
#ss-{{ sid }} .ss-announce { background: var(--ss-ink); color: white; text-align: center; padding: 10px 20px; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.05em; }
/* ── BUTTONS ── */
#ss-{{ sid }} .ss-btn { display: block; width: 100%; background: var(--ss-ink); color: white; font-family: var(--ss-font-ui); font-size: 0.95rem; font-weight: 600; letter-spacing: 0.01em; padding: 16px 28px; border-radius: var(--ss-r-full); border: none; cursor: pointer; text-decoration: none; text-align: center; transition: background 0.2s, transform 0.15s; }
#ss-{{ sid }} .ss-btn:hover { background: var(--ss-teal-deep); transform: translateY(-1px); }
#ss-{{ sid }} .ss-btn-ghost { background: transparent; color: var(--ss-ink-mid); border: 1.5px solid var(--ss-border); }
#ss-{{ sid }} .ss-btn-ghost:hover { border-color: var(--ss-teal); background: transparent; color: var(--ss-teal-deep); transform: none; }
#ss-{{ sid }} .ss-btn-teal { background: var(--ss-teal); }
#ss-{{ sid }} .ss-btn-teal:hover { background: var(--ss-teal-deep); }
#ss-{{ sid }} .ss-btn-mb { margin-bottom: 8px; }
#ss-{{ sid }} .ss-btn-final { max-width: 320px; margin: 0 auto; }
#ss-{{ sid }} .ss-btn-micro { font-size: 0.75rem; color: var(--ss-ink-muted); margin-top: 10px; }
/* ── HERO ── */
#ss-{{ sid }} .ss-hero { background: var(--ss-white); padding: 0; }
#ss-{{ sid }} .ss-hero-inner { display: flex; flex-direction: column; }
#ss-{{ sid }} .ss-hero-content { padding: 48px 22px 36px; text-align: center; order: 1; }
#ss-{{ sid }} .ss-hero-img-wrap { order: 2; width: 100%; overflow: hidden; max-height: 480px; }
#ss-{{ sid }} .ss-hero-img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }
#ss-{{ sid }} .ss-hero-brand { font-family: var(--ss-font-script); font-size: 1.15rem; color: var(--ss-teal); margin-bottom: 16px; display: block; }
#ss-{{ sid }} .ss-hero-sub { font-size: 1.05rem; line-height: 1.6; color: var(--ss-ink-muted); max-width: 34ch; margin: 16px auto 26px; }
/* ── STARS + RATING ── */
#ss-{{ sid }} .ss-rating { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 22px; font-size: 0.83rem; color: var(--ss-ink-muted); }
#ss-{{ sid }} .ss-stars { display: flex; gap: 2px; }
#ss-{{ sid }} .ss-stars svg { color: var(--ss-teal); }
#ss-{{ sid }} .ss-rating strong { color: var(--ss-ink); }
/* ── TRUST BADGES ── */
#ss-{{ sid }} .ss-trust-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; margin-bottom: 28px; }
#ss-{{ sid }} .ss-tbadge { display: flex; align-items: center; gap: 5px; font-size: 0.75rem; font-weight: 500; color: var(--ss-ink-muted); }
#ss-{{ sid }} .ss-tbadge svg { color: var(--ss-teal); flex-shrink: 0; }
/* ── WAVES ── */
