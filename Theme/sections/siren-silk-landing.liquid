#ss-{{ sid }} .ss-rcard-skin { font-size: 0.72rem; color: var(--ss-ink-muted); margin-top: 2px; }
#ss-{{ sid }} .ss-rcard-v { display: inline-flex; align-items: center; gap: 4px; font-size: 0.67rem; color: var(--ss-teal-deep); font-weight: 600; margin-top: 8px; }
/* ── RISK ── */
