#ss-{{ sid }} .ss-social     { padding: 44px 0; }
#ss-{{ sid }} .ss-risk       { padding: 36px 0; }
#ss-{{ sid }} .ss-offer      { padding: 44px 0; }
#ss-{{ sid }} .ss-final      { padding: 52px 0; }

/* ── FIX: хвильові розділювачі — прибираємо зайвий простір ── */
#ss-{{ sid }} .ss-wave-dn,
#ss-{{ sid }} .ss-wave-up { margin: 0; line-height: 0; font-size: 0; display: block; }

/* ── FIX: зображення в hero не розтягується надміру ── */
#ss-{{ sid }} .ss-hero-img-wrap { max-height: 340px; }
#ss-{{ sid }} .ss-hero-img { object-position: center 20%; }

/* ── FIX: product image в картках менша висота на мобілці ── */
#ss-{{ sid }} .ss-pimg { height: 180px; }

</style>

<!-- ═══════════ JAVASCRIPT ═══════════ -->
<script>
(function() {
  var ingScroll = document.getElementById('ss-ing-{{ sid }}');
  var dots = document.querySelectorAll('#ss-dots-{{ sid }} .ss-sdot');
  if (!ingScroll || !dots.length) return;
  ingScroll.addEventListener('scroll', function() {
    var card = ingScroll.querySelector('.ss-ing-card');
    if (!card) return;
    var cardW = card.offsetWidth + 12;
    var idx = Math.round(ingScroll.scrollLeft / cardW);
    dots.forEach(function(d, i) { d.classList.toggle('ss-sdot-on', i === idx); });
  }, { passive: true });
})();
</script>

