/* ── CERT STRIP ── */
#ss-{{ sid }} .ss-cert-strip { margin-top: 24px; padding: 18px; background: white; border-radius: var(--ss-r-md); border: 1.5px solid var(--ss-border); }
#ss-{{ sid }} .ss-cert-lbl { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ss-ink-muted); text-align: center; margin-bottom: 10px; display: block; }
#ss-{{ sid }} .ss-cert-tags { display: flex; flex-wrap: wrap; gap: 5px; justify-content: center; }
