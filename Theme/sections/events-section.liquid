<div class="events-section" id="{{ section.settings.id_section}}">
    <div class="container">
        {% if section.blocks.size > 0 %}
            {% assign current_city = '' %}
            {% assign current_date = '' %}
            {% assign city_open = false %}
            {% assign date_open = false %}
            
            {% for block in section.blocks %}
                {% comment %} Nueva ciudad {% endcomment %}
                {% if block.settings.city != current_city %}
                    {% if date_open %}</div>{% assign date_open = false %}{% endif %}
                    {% if city_open %}</div>{% endif %}
                    
                    <div class="city-block">
                        <h2 class="city-title">{{ block.settings.city }}</h2>
                        {% assign current_city = block.settings.city %}
                        {% assign city_open = true %}
                        {% assign current_date = '' %}
                {% endif %}
                
                {% comment %} Nueva fecha {% endcomment %}
                {% if block.settings.event_date != current_date %}
                    {% if date_open %}</div>{% endif %}
                    
                    <div class="date-block">
                        <div class="date-badge">{{ block.settings.event_date }}</div>
                        {% assign current_date = block.settings.event_date %}
                        {% assign date_open = true %}
                {% endif %}
                
                {% comment %} Item de ubicación {% endcomment %}
                <div class="location-item" {{ block.shopify_attributes }}>
                    <div class="location-header">
                        {% render 'location-point' %}
                        <h3 class="location-name">{{ block.settings.location_name }}</h3>
                    </div>
                    
                    <p class="location-address">{{ block.settings.address }}</p>
                    <p class="event-window">
                        <strong>Event Window:</strong> {{ block.settings.event_window }}
                    </p>
                    
                    {% if block.settings.map_link != blank %}
                        <a href="{{ block.settings.map_link }}" class="map-link">
                            See in Map
                        </a>
                    {% endif %}
                </div>
                
                {% comment %} Cerrar divs en el último bloque {% endcomment %}
                {% if forloop.last %}
                    {% if date_open %}</div>{% endif %}
                    {% if city_open %}</div>{% endif %}
                {% endif %}
            {% endfor %}
        {% else %}
            <p class="no-events">No events scheduled yet.</p>
        {% endif %}
    </div>

    <div class="logo_container">
      {% if section.settings.logo1 %}
                <img src="{{ section.settings.logo1 | image_url: width: 200 }}" alt="Logo 1">
      {% endif %}

        {% if section.settings.logo1 and section.settings.logo2 %}
                <span class="logo_separator">x</span>
        {% endif %}
            
            {% if section.settings.logo2 %}
                <img src="{{ section.settings.logo2 | image_url: width: 200 }}" alt="Logo 2">
            {% endif %}

    </div>

</div>

<style>
    .events-section {
        padding: 40px 20px;
        background-color: #F4EFEB;
    }
    
    .container {
        max-width: 1200px;
        margin: 0 auto;
        cursor: auto;
    }
    
    .city-block {
        background: #fff;
        padding: 30px;
        margin-bottom: 30px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .city-title {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 25px;
        color: #000;
    }
    
    .date-block {
        margin-bottom: 30px;
    }
    
    .date-block:last-child {
        margin-bottom: 0;
    }
    
    .date-badge {
        display: inline-block;
        background: #2FBBDC;
        color: #fff;
        padding: 8px 20px;
        border-radius: 11px;
        font-weight: 600;
        font-size: 16px;
        margin-bottom: 20px;
    }
    
    .location-item {
        padding: 20px 0;
    
    }
    
    .location-item:last-child {
        border-bottom: none;
    }
    
    .location-header {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }
    
    .location-icon {
        color: #3DBEE8;
        flex-shrink: 0;
    }
    
    .location-name {
        font-size: 18px;
        font-weight: 600;
        margin: 0;
        color: #000;
    }
    
    .location-address {
        margin: 5px 0;
        padding-left: 24px;
        color: #333;
        font-size: 14px;
    }
    
    .event-window {
        margin: 5px 0;
        padding-left: 24px;
        color: #333;
        font-size: 14px;
    }
    
    .event-window strong {
        font-weight: 600;
    }
    
    .map-link {
        display: inline-block;
        margin-top: 8px;
        margin-left: 24px;
        color: #3DBEE8;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }
    
    .map-link:hover {
        text-decoration: underline;
    }
    
    .no-events {
        text-align: center;
        padding: 60px 20px;
        color: #666;
        font-size: 18px;
    }
    .logo_container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 410px;
    margin: 0 auto;
    padding: 40px 0;
}
    
    @media (max-width: 768px) {
        .events-section {
            padding: 20px 15px;
        }
        
        .city-block {
            padding: 20px;
        }
        
        .city-title {
            font-size: 24px;
        }
        
        .date-badge {
            font-size: 14px;
            padding: 6px 16px;
        }
        .logo_container{
            flex-flow: column;
             row-gap: 20px;
        }

    }
</style>

{% schema %}
{
    "name": "Events Schedule",
    "settings": [
        {"type": "text", "id": "id_section", "label": "Section ID"},
        {"type": "image_picker", "id": "logo1", "label": "Logo 1"},
        {"type": "image_picker", "id": "logo2", "label": "Logo 2"},
    ],
    "blocks": [
        {
            "type": "location",
            "name": "Location",
            "settings": [
                {
                    "type": "text",
                    "id": "city",
                    "label": "City",
                    "default": "NYC",
                    "info": "Group locations by city (e.g., NYC, Metro SLC)"
                },
                {
                    "type": "text",
                    "id": "event_date",
                    "label": "Event Date",
                    "default": "October 19",
                    "info": "Date label (e.g., October 19)"
                },
                {
                    "type": "text",
                    "id": "location_name",
                    "label": "Location Name",
                    "default": "Fort Greene"
                },
                {
                    "type": "text",
                    "id": "address",
                    "label": "Address",
                    "default": "292 Ashland Pl"
                },
                {
                    "type": "text",
                    "id": "event_window",
                    "label": "Event Window",
                    "default": "10am to 2pm",
                    "info": "Event time range"
                },
                {
                    "type": "url",
                    "id": "map_link",
                    "label": "Map Link",
                    "info": "Google Maps or other map URL"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Events Schedule",
            "blocks": [
                {
                    "type": "location",
                    "settings": {
                        "city": "NYC",
