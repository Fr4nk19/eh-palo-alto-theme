<div class="wrap_hero">
    <div class="conten_hero">
        <div class="logo_content">
            {% if section.settings.logo1 %}
                <img src="{{ section.settings.logo1 | image_url: width: 200 }}" alt="Logo 1">
            {% endif %}
            
            {% if section.settings.logo1 and section.settings.logo12 %}
                <span class="logo_separator">x</span>
            {% endif %}
            
            {% if section.settings.logo12 %}
                <img src="{{ section.settings.logo12 | image_url: width: 200 }}" alt="Logo 2">
            {% endif %}
        </div>
        
        <div class="caption_content"> 
            {% if section.settings.title_hero %}
                <h1>{{ section.settings.title_hero }}</h1>
            {% endif %}
            
            {% if section.settings.description %}
                <p>{{ section.settings.description }}</p>
            {% endif %}
            
            {% if section.settings.label_cta and section.settings.link_cta %}
                <a href="{{ section.settings.link_cta }}" class="btn-cta">
                    {{ section.settings.label_cta }}
                </a>
            {% endif %}
        </div>
    </div>
</div>

<style>
    .wrap_hero {
        background: url({{ section.settings.banner_image | image_url: width: 2600 }}) no-repeat center center;
        background-size: cover;
        min-height: 880px;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 60px 20px;
        margin: 0 auto;
        border-radius: 20px;
        max-width: 90%;
        margin:0 auto;
    }
    
    .conten_hero {
        max-width: 1200px;
        width: 100%;
        text-align: center;
    }
    
    .logo_content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 20px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }
    
    .logo_content img {
        max-width: 150px;
        height: auto;
    }
    
    .logo_separator {
        font-size: 24px;
        font-weight: bold;
        color: #000;
    }
    
    .caption_content h1 {
        font-size: 68px;
        margin-bottom: 20px;
        color: #000;
        font-family: "Montserrat", sans-serif;
    }
    
    .caption_content p {
        font-size: 20px;
        margin-bottom: 30px;
        color: #000;
    }
    
    .btn-cta {
        display: inline-block;
        padding: 15px 40px;
        background-color: #000;
        color: #fff;
        text-decoration: none;
        border-radius: 20px;
        font-weight: bold;
        transition: all 0.3s ease;
        font-size:12px;
    }
    .btn-cta:hover{
        color: #fff;
    }
    @media (max-width: 768px) {
        .wrap_hero {
            min-height: 400px;
            padding: 40px 20px;
        }
        
        .caption_content h1 {
            font-size: 32px;
        }
        
        .caption_content p {
            font-size: 16px;
        }
        
        .logo_content img {
            max-width: 100px;
        }
    }
</style>

{% schema %}
{
    "name": "Hero Image",
    "settings": [
        {
            "type": "header",
            "content": "Banner"
        },
        {
            "type": "image_picker",
            "id": "banner_image",
            "label": "Banner Image"
        },
        {
            "type": "header",
            "content": "Logos"
        },
        {
            "type": "image_picker",
            "id": "logo1",
            "label": "Logo 1"
        },
        {
            "type": "image_picker",
            "id": "logo12",
            "label": "Logo 2"
        },
        {
            "type": "header",
            "content": "Caption"
        },
        {
            "type": "text",
            "id": "title_hero",
            "label": "Title Hero"
        },
        {
            "type": "text",
            "id": "description",
            "label": "Description"
        },
        {
            "type": "header",
            "content": "CTA"
        },
        {
            "type": "text",
            "id": "label_cta",
            "label": "Label CTA"
        },
        {
            "type": "url",
            "id": "link_cta",
            "label": "CTA Link"
        }
    ],
    "presets": [
        { "name": "Hero Image" }
    ]
}
{% endschema %}