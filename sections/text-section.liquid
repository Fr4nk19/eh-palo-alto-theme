<div class="wrap-content">

    <div class="content_info">
        <h3>{{ section.settings.title_section }}</h3>
        {{ section.settings.content_section }}
    </div>

</div>
<style>
    .wrap-content {
        padding: 40px 0;
    }
    .content_info {
        max-width: 600px;
        margin: 0 auto;
    }
    .content_info h3 {
        font-size: 30px;
        font-family: "Montserrat", sans-serif;
        margin-bottom: 20px;
        text-align: center;
    }
    .content_info ul {
        list-style: disc;
    }
    .content_info ul li{
        font-size: 19px;
    }

</style>
{% schema %}
  {
    "name": "Text Section",
    "settings": [
        {
            "type": "text",
            "id": "title_section",
            "label": "Title Section"
        },
        {
            "type": "richtext",
            "id": "content_section",
            "label": "Content Section"
        }
    ],
    "presets": [
      {
        "name": "Text Section"
      }
    ] 
  }
{% endschema %}