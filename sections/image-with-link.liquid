{% comment %}
  Sección simple: Imagen con enlace
  Archivo: sections/image-with-link.liquid
{% endcomment %}

<div class="image-link-section" style="text-align:center; padding:60px 20px;" id="{{ section.settings.id_section }}">
  {% if section.settings.image != blank %}
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" {% if section.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
        {{ section.settings.image 
          | image_url: width: 1600 
          | image_tag: loading: 'lazy', class: 'image-link-img', alt: section.settings.alt_text }}
      </a>
    {% else %}
      {{ section.settings.image 
        | image_url: width: 1600 
        | image_tag: loading: 'lazy', class: 'image-link-img', alt: section.settings.alt_text }}
    {% endif %}
  {% endif %}
</div>

<style>
  .image-link-img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    transition: transform .3s ease, box-shadow .3s ease;
  }
</style>

{% schema %}
{
  "name": "Map Image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open in a new tab", "default": false },
    { "type": "text", "id": "alt_text", "label": "Alt text" },
    {"type": "text", "id": "id_section", "label": "ID Section"}
  ],
  "presets": [
    { "name": "Map Image" }
  ]
}
{% endschema %}
