{{ 'custom-freegift-landing.css' | asset_url | stylesheet_tag }}

<div class="free-gift-wrapper">
  <img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image_alt_text }}" width="650px" height="100%" />
  <div class="content">
    <div class="heading-wrapper">
  <div class="heading">
    {{ section.settings.title }} 
    </div>
    <div class="subheading">
      {{ section.settings.subtitle }}
    </div>
</div>
<div class="klaviyo-form-custom">
  <div class="klaviyo-form-StfWjR"></div>
</div>
  </div>
</div>




{% schema %} 
  {
    "name": "Free Gift Form with Image",
    "tag": "section",
    "class": "freegift-form-img",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "inline_richtext", 
        "id": "title",
        "label": "Title"
      },
      {
        "type": "richtext",
        "id": "subtitle",
        "label": "Subtitle"
      }
    ],
    "presets": [
      {
        "name": "Free Gift with Image"
      }
    ] 
  }
{% endschema %}