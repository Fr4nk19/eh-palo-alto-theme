{%- comment -%}
  Cart Recommendations Section
  Used by Shopify's Product Recommendations API:
    /recommendations/products?product_id=ID&limit=10&section_id=cart-recommendations
  Renders individual product slides injected into the cart drawer slider.
{%- endcomment -%}

{%- if recommendations.performed and recommendations.products_count > 0 -%}
  {%- liquid
    assign button_style = settings.upsells_button_style | default: 'btn--solid-border'
    assign button_color = settings.upsells_button_color | default: 'btn--secondary'
    assign button_size  = settings.upsells_button_size  | default: 'btn--medium'
    if button_style == 'btn--text'
      assign button_advanced_class = 'btn--advanced'
    else
      assign button_advanced_class = 'btn--advanced btn--advanced-width-height btn--advanced-adaptive-width'
    endif
  -%}

  {%- for product in recommendations.products -%}
    {%- assign first_variant = product.first_available_variant -%}
    <div class="cart-rec__slide">
      <a class="cart-rec__image-wrap" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
        {%- if product.featured_media -%}
          <img
            class="cart-rec__img"
            src="{{ product.featured_media.preview_image | image_url: width: 300 }}"
            alt="{{ product.featured_media.preview_image.alt | escape | default: product.title }}"
            width="300"
            height="{{ 300 | divided_by: product.featured_media.preview_image.aspect_ratio | ceil }}"
            loading="lazy">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg cart-rec__placeholder' }}
        {%- endif -%}
      </a>

      <div class="cart-rec__body">
        <p class="cart-rec__title">
          <a href="{{ product.url }}">{{ product.title | strip_html | truncatewords: 6 }}</a>
        </p>

        {%- if product.variants.size > 1 -%}
          <p class="cart-rec__meta">{{ product.variants.size }} {{ 'cart.recommendations.shades' | t | default: 'shades' }}</p>
        {%- endif -%}

        {%- if first_variant != blank -%}
          {%- if product.variants.size == 1 and product.selling_plan_groups.size == 0 -%}
            <button
              type="button"
              class="cart-rec__btn btn {{ button_style }} {{ button_size }} {{ button_color }} {{ button_advanced_class }}"
              data-variant-id="{{ first_variant.id }}"
              data-add-rec-to-cart>
              <hover-button></hover-button>
              <span class="cart-rec__btn-text">{{ 'cart.recommendations.add' | t }}</span>
              <svg class="cart-rec__btn-spinner" viewBox="0 0 18 18" aria-hidden="true">
                <circle cx="9" cy="9" r="7"></circle>
              </svg>
            </button>
          {%- else -%}
            <a
              class="cart-rec__btn btn {{ button_style }} {{ button_size }} {{ button_color }} {{ button_advanced_class }}"
              href="{{ product.url }}">
              <hover-button></hover-button>
              <span class="cart-rec__btn-text">{{ 'cart.recommendations.choose' | t }}</span>
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
{%- endif -%}
