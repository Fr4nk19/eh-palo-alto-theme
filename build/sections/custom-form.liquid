<div class="custom-form-wrapper">
  {% for block in section.blocks %}
    {% render block %}
  {% endfor %}
</div>

{% schema %} 
  {
    "name": "Custom Form",
    "class": "custom-form",
    "settings": [],
    "blocks": [
      {
        "type": "@app"
      }
  ],
    "presets": [
      {
        "name": "Custom Form"
      }
    ]
  }
{% endschema %}