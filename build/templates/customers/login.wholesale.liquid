 <script>
document.addEventListener("DOMContentLoaded", () => {
  const params = new URLSearchParams(window.location.search);
  const hideWholesaleEls = document.querySelectorAll(".hide-wholesale");
  const wholesaleApply = document.querySelector(".wholesale-apply");

  // Detectores
  const urlFromQuery = params.get("return_url");
  const isWholesaleView = (params.get("view") || "").includes("wholesale");
  const fromLogin = (params.get("from") || "").includes("wholesale");

  let fromReturn = false;
  if (urlFromQuery) {
    const decoded = decodeURIComponent(urlFromQuery);
    const innerParams = new URLSearchParams(decoded.split("?")[1] || "");
    fromReturn = (innerParams.get("from") || "").includes("wholesale");
  }

  // --- 1) Setear return_to ---
  let desiredReturn = "/account";
  if (urlFromQuery) {
    try {
      const u = new URL(decodeURIComponent(urlFromQuery), window.location.origin);
      desiredReturn = u.pathname + (u.search || "");
    } catch(e) {
      desiredReturn = decodeURIComponent(urlFromQuery);
    }
  } else if (isWholesaleView) {
    desiredReturn = "/pages/wholesale";
  }
  const input = document.getElementById("return_to_wholesale");
  if (input) input.value = desiredReturn;

  // --- 2) Mostrar UI wholesale SI:
  //      view=wholesale  || from=wholesale  || return_url con from=wholesale
  if (isWholesaleView || fromLogin || fromReturn) {
    wholesaleApply?.removeAttribute("hidden");
    hideWholesaleEls.forEach(el => el.setAttribute("hidden",""));

    const loginHeading = document.querySelector(".login-heading");
    if (loginHeading) loginHeading.textContent = "Wholesale Account Log-In";
  }
});
</script>

