{%- liquid
  assign animations_enabled = settings.animations_enabled
  assign animation_delay = 200
  assign subtotal = cart.total_price | plus: 0
  assign cart_items_size = cart.item_count
  assign has_progress_holder = true
  assign cart_button_style = settings.cart_button_style
  assign cart_button_size = settings.cart_button_size
  assign cart_button_color = settings.cart_button_color

  assign has_dynamic_checkout_buttons = false
  if settings.enable_additional_buttons and additional_checkout_buttons
    assign has_dynamic_checkout_buttons = true
  endif
-%}

<div id="cart-drawer" class="cart-drawer cv-h" data-cart-drawer role="dialog" aria-modal="true">
  <template data-cart-drawer-template>
    {% if settings.cart_custom_message_text != blank %}
      <div class="cart-message cart-message--custom {{ settings.cart_custom_message_color }}" data-cart-bar>
        <div{% if animations_enabled %}
          data-aos="fade"
          data-aos-delay="{{ animation_delay }}"
          {%- assign animation_delay = animation_delay | plus: 50 -%}
        {% endif %}>
          {{ settings.cart_custom_message_text }}
        </div>
      </div>
    {% endif %}
    <div class="cart-drawer__head"
      {% if animations_enabled %}
        data-aos="fade"
        data-aos-delay="{{ animation_delay }}"
        {%- assign animation_delay = animation_delay | plus: 50 -%}
      {% endif %}>
      <h3>{{ 'cart.general.title' | t }}<span class="cart-drawer__item-qty{% if cart_items_size == 0 %} hidden{% endif %}" data-cart-items-qty>{{ 'cart.label.items_with_count' | t: count: cart_items_size }}</span></h3>

      <a href="#cart-drawer" class="cart-drawer__close" data-cart-drawer-toggle aria-label="{{ 'general.accessibility.close_drawer' | t }} {{ 'cart.general.title' | t }}">
        {%- render 'icon-close' -%}
      </a>

      <div class="loader loader--line"><div class="loader-indeterminate"></div></div>
    </div>

    <div class="cart-drawer__body" data-cart-drawer-body>{%- liquid
  assign free_shipping_text = block.settings.message | default: settings.message
  assign is_enable = false

  if block.settings.message != blank
    assign is_enable = true
  endif

  if settings.show_free_shipping_message and settings.free_shipping_limit != blank and free_shipping_text != blank
    assign is_enable = true
  endif
-%}

{%- if is_enable -%}
  {%- liquid
    assign limit = settings.free_shipping_limit | plus: 0
    assign limit_currency = limit | times: 100
    assign cart_total_price = cart.total_price
    assign subtotal_without_currency = cart_total_price | plus: 0 | divided_by: 100
  -%}

  {%- capture left_to_spend -%}
    <span data-left-to-spend>
      {%- if settings.currency_code_enable -%}
        <span class="wh-original-cart-total"><span class='wh-original-price'>{{- limit_currency | minus: cart_total_price | money_without_trailing_zeros | append: ' ' | append: cart.currency.iso_code -}}</span></span><span class="wh-cart-total"></span><span class="additional-notes"><span class="wh-minimums-note"></span><span class="wh-extra-note"></span></span>
      {%- else -%}
        <span class="wh-original-cart-total"><span class='wh-original-price'>{{- limit_currency | minus: cart_total_price | money_without_trailing_zeros -}}</span></span><span class="wh-cart-total"></span><span class="additional-notes"><span class="wh-minimums-note"></span><span class="wh-extra-note"></span></span>
      {%- endif -%}
    </span>
  {%- endcapture -%}



  {%- liquid
    assign free_shipping_message = free_shipping_text | replace: '||amount||', left_to_spend
    assign qualified_shipping_message = 'cart.general.qualified_shipping_message' | t
    assign class_message = ''

    if subtotal_without_currency >= limit
      if qualified_shipping_message != blank
        assign class_message = ' is-success'
        assign is_default_message_hidden = ' is-hidden'
      else
        assign class_message = ' is-hidden'
      endif
    elsif subtotal_without_currency == 0
      assign class_message = ' is-hidden'
    endif

    assign percent = limit | minus: subtotal_without_currency | times: 100 | divided_by: limit
    assign percent = 100 | minus: percent
  -%}

  <p class="{% unless template.name == 'cart' or section.id == 'announcement-bar' %}cart-message--drawer {% endunless %}cart-message{{ class_message }}"
    data-cart-message="{% if qualified_shipping_message != blank %}true{% else %}false{% endif %}"
    data-limit="{{ limit }}"
    {% if animations_enabled %}
      data-aos="fade"
      {% if aos_anchor %}
        data-aos-anchor="{{ aos_anchor }}"
      {% endif %}
      data-aos-delay="{{ animation_delay }}"
      {%- assign animation_delay = animation_delay | plus: 100 -%}
    {% endif %}
  >
    <span class="cart-message__default{{ is_default_message_hidden }}" data-message-default>{{ free_shipping_message }}</span>

    {%- if qualified_shipping_message != blank -%}
      <span class="cart-message__success">{{ qualified_shipping_message }}</span>
    {%- endif -%}

    {%- if has_progress_holder -%}
      <span class="cart-message__progress-holder">
        <progress class="cart-message__progress" data-cart-message-progress value="{{ percent }}" max="100" style="--progress-width: {{ percent }}%;"></progress>
        {%- comment -%}Second progress bar shows only on Firefox{%- endcomment -%}
        <progress class="cart-message__progress" data-cart-message-progress max="100" style="--progress-width: {{ percent }}%;"></progress>
      </span>
    {%- endif -%}
  </p>
{%- endif -%}
{% if customer.tags contains settings.wholesale_tag %}
  <p id="wholesale-progress-text">You’re <span data-non-excluded-qty id="productsWholesale"></span> items away from wholesale pricing</p>
{% endif %}

      <div class="cart__errors cart-drawer__errors" role="alert" data-cart-errors>
        <div class="cart__errors__inner">
          <p class="cart__errors__heading">{{- 'cart.general.limit_error' | t -}}</p>

          <p class="cart__errors__content" data-error-message></p>

          <button type="button" class="cart__errors__close" data-cart-error-close aria-label="{{ 'general.accessibility.dismiss' | t }} {{ 'cart.general.title' | t }}">
            {%- render 'icon-close' -%}
          </button>
        </div>
      </div>

      <div id="cartItemsHolder" class="cart-drawer__items{% if cart_items_size == 0 %} hidden{% endif %}" data-items-holder>
        {%- render 'cart-line-items', part: 'line-items', aos_anchor: '#cartItemsHolder' -%}
      </div>

      <div class="cart__widgets"
        {% if animations_enabled %}
          data-aos="fade"
          {%- assign animation_delay = animation_delay | plus: 150 -%}
          data-aos-delay="{{ animation_delay }}"
          {%- assign animation_delay = animation_delay | plus: 50 -%}
        {% endif %}>
        <div id="cartUpsellHolder" class="cart__pair" data-cart-widget data-pair-products-holder
          {% if animations_enabled %}
            data-aos="fade"
            data-aos-delay="{{ animation_delay }}"
            {%- assign animation_delay = animation_delay | plus: 50 -%}
          {% endif %}>
          {%- render 'cart-line-items', part: 'upsell-items', aos_anchor: '#cartUpsellHolder' -%}
        </div>

        {%- render 'cart-recommended-products' -%}

        <div class="cart-notes{% if cart_items_size == 0 %} hidden{% endif %}" data-cart-notes-holder>
          {%- if settings.enable_cart_notes or settings.enable_gift_notes -%}
            <div class="cart__widget__wrapper" data-collapsible-single>
              {%- if settings.enable_cart_notes -%}
                <div class="cart__widget" data-cart-widget
                  {% if animations_enabled %}
                    data-aos="fade"
                    data-aos-delay="{{ animation_delay }}"
                    {%- assign animation_delay = animation_delay | plus: 50 -%}
                  {% endif %}>
                  <button
                    class="cart__widget__title"
                    type="button"
                    data-collapsible-trigger
                    aria-expanded="false"
                    aria-controls="notes">
                    {{- 'cart.general.cart_notes_label' | t -}}
                    {%- render 'icon-toggle-plus' -%}
                    {%- render 'icon-toggle-minus' -%}
                  </button>

                  <div id="notes" aria-expanded="false" data-collapsible-container>
                    <div class="cart__widget__content" data-collapsible-content>
                      <label for="note">{{ 'cart.general.customer_note' | t }}</label>

                      <textarea id="note" name="note" form="cartDrawerCheckoutForm" class="cart__field cart__field--textarea" aria-label="{{ 'cart.general.customer_note' | t }}">{{- cart.note -}}</textarea>
                    </div>
                  </div>
                </div>
              {%- endif -%}

              {%- if settings.enable_gift_notes -%}
                <div class="cart__widget" data-cart-widget
                  {% if animations_enabled %}
                    data-aos="fade"
                    data-aos-delay="{{ animation_delay }}"
                    {%- assign animation_delay = animation_delay | plus: 50 -%}
                  {% endif %}>
                  <button
                    class="cart__widget__title"
                    type="button"
                    data-collapsible-trigger
                    aria-expanded="false"
                    aria-controls="gift-notes">
                    {{- 'cart.general.gift_notes_label' | t -}}
                    {%- render 'icon-toggle-plus' -%}
                    {%- render 'icon-toggle-minus' -%}
                  </button>

                  <div id="gift-notes" aria-expanded="false" data-collapsible-container>
                    <div class="cart__widget__content" data-collapsible-content>
                      {%- liquid
                        assign gift_note_attribute_default = 'Gift note'
                        assign gift_note_attribute_string = 'cart.general.gift_note_attribute' | t
                        assign gift_note_attribute = gift_note_attribute_string | default: gift_note_attribute_default
                      -%}

                      <label for="gift-note">{{ 'cart.general.note' | t }}</label>

                      <textarea id="gift-note" name="attributes[{{ gift_note_attribute }}]" form="cartDrawerCheckoutForm" class="cart__field cart__field--textarea" aria-label="{{ 'cart.general.note' | t }}">{{ cart.attributes[gift_note_attribute] }}</textarea>
                    </div>
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div id="cartDrawerEmptyMessage" class="cart-drawer__empty-message{% if cart_items_size > 0 %} hidden{% endif %}" data-empty-message>
        {%- assign aos_anchor = '#cartDrawerEmptyMessage' -%}{%- liquid
  assign animation_order = animation_order | default: 1
  assign empty_cart_heading = settings.empty_cart_heading
  assign empty_cart_heading_size = settings.empty_cart_heading_size | times: 0.01
-%}

{%- capture cart_empty_drawer_markup -%}
  <p
    {% if animations_enabled %}
      data-aos="hero"
      data-aos-anchor="{{ aos_anchor }}"
      data-aos-order="{{ animation_order }}"
      {%- assign animation_order = animation_order | plus: 1 -%}
    {% endif %}>
    {{ 'cart.general.empty' | t }}
  </p>

  {% if empty_cart_heading != blank %}
    <h3
      {% if animations_enabled %}
        data-aos="hero"
        data-aos-anchor="{{ aos_anchor }}"
        data-aos-order="{{ animation_order }}"
        {%- assign animation_order = animation_order | plus: 1 -%}
      {% endif %}
      style="--adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ empty_cart_heading_size }});">
      {{ empty_cart_heading }}
    </h3>
  {% endif %}

  {%- render 'cart-empty-collections', animations_enabled: animations_enabled, aos_anchor: aos_anchor, animation_order: animation_order -%}
{%- endcapture -%}

{%- capture cart_empty_page_markup -%}
  <div class="section__header">
    <h1 class="section__heading h2"
      {% if animations_enabled %}
        data-aos="hero"
        data-aos-anchor="{{ aos_anchor }}"
        data-aos-order="{{ animation_order }}"
        {%- assign animation_order = animation_order | plus: 1 -%}
      {% endif %}>
      {{- 'cart.general.title' | t -}}
    </h1>

    {%- if settings.show_spacer_lines -%}
      <hr class="section__heading-line"
        {% if animations_enabled %}
          data-aos="hero"
          data-aos-anchor="{{ aos_anchor }}"
          data-aos-order="{{ animation_order }}"
          {%- assign animation_order = animation_order | plus: 1 -%}
        {% endif %}>
    {%- endif -%}

    <p
      {% if animations_enabled %}
        data-aos="hero"
        data-aos-anchor="{{ aos_anchor }}"
        data-aos-order="{{ animation_order }}"
        {%- assign animation_order = animation_order | plus: 1 -%}
      {% endif %}>
      {{- 'cart.general.empty' | t -}}
    </p>

    {% if empty_cart_heading != blank %}
      <h3
        {% if animations_enabled %}
          data-aos="hero"
          data-aos-anchor="{{ aos_anchor }}"
          data-aos-order="{{ animation_order }}"
          {%- assign animation_order = animation_order | plus: 1 -%}
        {% endif %}
        style="--adjust-heading: calc(var(--FONT-ADJUST-HEADING) * {{ empty_cart_heading_size }});">
        {{- empty_cart_heading -}}
      </h3>
    {% endif %}
  </div>

  {%- render 'cart-empty-collections', animations_enabled: animations_enabled, aos_anchor: aos_anchor, animation_order: animation_order -%}

  {%- render 'cart-empty-buttons', animations_enabled: animations_enabled, section_bg_color: bg_color, aos_anchor: aos_anchor, animation_order: animation_order -%}

  {%- render 'cart-empty-message', animations_enabled: animations_enabled, aos_anchor: aos_anchor, animation_order: animation_order -%}
{%- endcapture -%}

{%- if template.name == 'cart' -%}
  {{ cart_empty_page_markup }}
{%- else -%}
  {{ cart_empty_drawer_markup }}
{%- endif -%}


</div>
    </div>

    <div class="cart-drawer__foot cart__foot"
      data-foot-holder
      {% if animations_enabled %}
        data-aos="fade-up"
        data-aos-delay="{{ animation_delay }}"
        {%- assign animation_delay = animation_delay | plus: 50 -%}
      {% endif %}>
      <form id="cartDrawerCheckoutForm"{% if cart_items_size == 0 %} class="hidden"{% endif %} action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
        <div class="cart__foot-inner">

          <div data-cart-price-holder>
            {%- liquid
  assign subtotal = cart.total_price | plus: 0
  assign cart_discount_size = cart.cart_level_discount_applications.size
  assign original_subtotal = cart.original_total_price | plus: 0
  assign currency_code_enable = settings.currency_code_enable

  if currency_code_enable
    assign original_subtotal_formatted = original_subtotal | money_with_currency
  else
    assign original_subtotal_formatted = original_subtotal | money
  endif

  if original_subtotal < subtotal or cart_discount_size == 0
    assign cart_total_hidden = true
  endif

  if cart_discount_size == 0
    assign cart_total_discount_hidden = true
  endif
-%}

<div class="cart__total{% if cart_total_hidden %} hidden{% endif %}">
  <span>{{- 'cart.general.subtotal_items' | t -}}</span>

  <span data-cart-total="{{ subtotal }}">
    {%- liquid
      if original_subtotal == 0
        echo 'products.product.free' | t
      else
        echo original_subtotal_formatted
      endif
    -%}
  </span>
</div>

{%- unless cart_total_discount_hidden -%}
  <div class="cart__discounts">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      {%- for discount in cart.cart_level_discount_applications -%}
        {%- liquid
          if currency_code_enable
            assign total_allocated_discount = discount.total_allocated_amount | money_with_currency
          else
            assign total_allocated_discount = discount.total_allocated_amount | money
          endif
        -%}
        <div class="cart__total">
          <span>
            {{- discount.title -}}
          </span>

          <span>
            -{{- total_allocated_discount -}}
          </span>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endunless -%}

          </div>

          <div class="cart__buttons-wrapper">
            {%- if settings.enable_accept_terms -%}
              <input type="hidden" name="attributes[{{ 'cart.general.accepted_terms' | t }}]" value="Yes"/>
              <input type="checkbox" class="cart__acceptance__input" name="acceptance" id="acceptance" data-cart-acceptance-checkbox>
              <label for="acceptance" class="cart__acceptance__label" data-cart-acceptance-label>{{ settings.accept_terms_text }}</label>
            {%- endif -%}

            <p class="cart__terms cart__errors__content" data-terms-error-message></p>

            <div class="cart__buttons{% if settings.enable_accept_terms %} cart__buttons--disabled{% endif %}" data-cart-checkout-buttons>
              <fieldset class="cart__buttons__fieldset" data-cart-checkout-button>
                <button type="submit" name="checkout" class="cart__checkout btn {{ cart_button_style }} {{ cart_button_color }} {{ cart_button_size }} btn--advanced btn--advanced-width-height btn--advanced-adaptive-width{% if has_dynamic_checkout_buttons %} cart__checkout--dynamic{% endif %}">
                  <hover-button></hover-button>
                  {{- 'cart.general.checkout' | t -}}
                  <span class="cart__total__money" data-cart-total-price>
                    {%- liquid
                      if subtotal == 0
                        echo 'products.product.free' | t
                      else
                        echo subtotal | money_with_currency
                      endif
                    -%}
                  </span>
                </button>

                {%- if has_dynamic_checkout_buttons -%}
                  <div class="additional-checkout-buttons additional-checkout-buttons--vertical" data-additional-checkout-button>
                    {{- content_for_additional_checkout_buttons -}}
                  </div>
                {%- endif -%}

              </fieldset>
            </div>
          </div>

          <p class="cart__text">{{ 'cart.general.shipping_at_checkout' | t }}</p>
        </div>
      </form>

      <div id="cartDrawerEmptyMessageBottom" class="cart-drawer__empty-message cart-drawer__empty-message--bottom{% if cart_items_size > 0 %} hidden{% endif %}" data-empty-message-bottom>
        {%- assign aos_anchor = '#cartDrawerEmptyMessageBottom' -%}{%- assign animation_order = animation_order | default: 1 -%}

{%- render 'cart-empty-buttons', animations_enabled: animations_enabled, section_bg_color: bg_color, aos_anchor: aos_anchor, animation_order: animation_order -%}

{%- render 'cart-empty-message', animations_enabled: animations_enabled, aos_anchor: aos_anchor, animation_order: animation_order -%}</div>
    </div>
  </template>
</div>

<script>window.WHOLESALE_QTY = {{ settings.wholesale_qty | default: 0 | json }};</script>

<script>
/* ── Cart Recommended Products ── */
(function () {
  'use strict';

  var recState = { productId: null };
  var PER_PAGE = 3;

  /* ────────────────────────────────────────────
     Load recommendations via Shopify section API
  ──────────────────────────────────────────── */
  function loadRecommendations() {
    var holder = document.getElementById('cartRecommendations');
    if (!holder) return;

    var productId = holder.getAttribute('data-product-id');
    if (!productId || productId === recState.productId) return;
    recState.productId = productId;

    var limit  = holder.getAttribute('data-rec-limit') || 10;
    var slider = holder.querySelector('[data-rec-slider]');
    var dotsEl = holder.querySelector('[data-rec-dots]');
    if (!slider) return;

    var url = '/recommendations/products?product_id=' + productId +
              '&limit=' + limit + '&section_id=cart-recommendations';

    fetch(url)
      .then(function (r) { return r.text(); })
      .then(function (html) {
        var doc    = new DOMParser().parseFromString(html, 'text/html');
        var slides = doc.querySelectorAll('.cart-rec__slide');

        if (!slides.length) {
          /* Shopify had no signals (e.g. incognito) — fall back to collection */
          collectionFallback(holder, slider, dotsEl);
          return;
        }

        slides.forEach(function (s) { slider.appendChild(document.adoptNode(s)); });

        /* Double rAF ensures the browser has laid out the new nodes
           before Flickity measures cell widths */
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            if (typeof window.Flickity !== 'undefined') {
              tryFlickity(slider, dotsEl, slides.length);
            } else {
              initScrollDots(slider, dotsEl, slides.length);
            }
          });
        });
      })
      .catch(function (e) {
        console.warn('[Cart Rec]', e);
        if (holder) holder.style.display = 'none';
      });
  }

  /* ────────────────────────────────────────────
     Flickity (preferred)
  ──────────────────────────────────────────── */
  function tryFlickity(slider, dotsEl, slideCount) {
    try {
      var flkty = new window.Flickity(slider, {
        cellAlign    : 'left',
        contain      : true,
        pageDots     : false,
        prevNextButtons: false,
        wrapAround   : false,
        groupCells   : '100%',
        accessibility: true,
      });

      var cellW   = flkty.cells.length ? flkty.cells[0].size.outerWidth : 0;
      var visible = cellW ? Math.max(1, Math.round(flkty.size.width / cellW)) : PER_PAGE;
      var pages   = Math.ceil(slideCount / visible);

      if (pages > 1 && dotsEl) {
        var dots = makeDots(dotsEl, pages);
        dotsEl.addEventListener('click', function (e) {
          var b = e.target.closest('.cart-rec__dot');
          if (b) flkty.select(parseInt(b.dataset.page, 10) * visible);
        });
        flkty.on('select', function () {
          var active = Math.floor(flkty.selectedIndex / visible);
          dots.forEach(function (d, i) { d.classList.toggle('is-selected', i === active); });
        });
      }
    } catch (e) {
      console.warn('[Cart Rec] Flickity failed, CSS scroll fallback:', e);
      initScrollDots(slider, dotsEl, slideCount);
    }
  }

  /* ────────────────────────────────────────────
     CSS scroll-snap fallback + dots
  ──────────────────────────────────────────── */
  function initScrollDots(slider, dotsEl, slideCount) {
    var pages = Math.ceil(slideCount / PER_PAGE);
    if (pages <= 1 || !dotsEl) return;

    var dots = makeDots(dotsEl, pages);

    /* Dot click → scroll to page */
    dotsEl.addEventListener('click', function (e) {
      var b = e.target.closest('.cart-rec__dot');
      if (!b) return;
      var page    = parseInt(b.dataset.page, 10);
      var slideW  = slider.scrollWidth / slideCount;
      slider.scrollTo({ left: page * slideW * PER_PAGE, behavior: 'smooth' });
    });

    /* Scroll → update dots */
    slider.addEventListener('scroll', function () {
      var slideW = slider.scrollWidth / slideCount;
      var page   = Math.min(Math.round(slider.scrollLeft / (slideW * PER_PAGE)), pages - 1);
      dots.forEach(function (d, i) { d.classList.toggle('is-selected', i === page); });
    }, { passive: true });
  }

  /* ────────────────────────────────────────────
     Dot button builder (shared)
  ──────────────────────────────────────────── */
  function makeDots(container, count) {
    container.innerHTML = '';
    var list = [];
    for (var i = 0; i < count; i++) {
      var b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', 'Page ' + (i + 1));
      b.className = 'cart-rec__dot' + (i === 0 ? ' is-selected' : '');
      b.dataset.page = i;
      container.appendChild(b);
      list.push(b);
    }
    return list;
  }

  /* ────────────────────────────────────────────
     Add to cart AJAX handler
  ──────────────────────────────────────────── */
  function addRecToCart(btn) {
    var variantId = btn.getAttribute('data-variant-id');
    if (!variantId || btn.classList.contains('is-loading')) return;

    btn.classList.add('is-loading');
    btn.disabled = true;

    fetch('/cart/add.js', {
      method : 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body   : JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 }),
    })
    .then(function (r) {
      if (!r.ok) return r.json().then(function (e) { throw e; });
      return r.json();
    })
    .then(function () {
      btn.classList.remove('is-loading');
      btn.classList.add('is-success');

      /* Update cart count badges from /cart.js */
      return fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
        document.querySelectorAll('[data-cart-count]').forEach(function (el) {
          el.textContent = cart.item_count;
        });
        document.querySelectorAll('[data-cart-items-qty]').forEach(function (el) {
          var label = cart.item_count === 1 ? '1 item' : cart.item_count + ' items';
          el.textContent = label;
        });

        /* Notify theme to refresh cart drawer content */
        ['cart:refresh', 'cart:build', 'theme:cart:add'].forEach(function (name) {
          document.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: { count: cart.item_count } }));
        });
      });
    })
    .then(function () {
      /* Fade out & remove this slide (product is now in cart) */
      var slide = btn.closest('.cart-rec__slide');
      if (slide) {
        slide.style.transition = 'opacity 0.35s';
        slide.style.opacity    = '0';
        setTimeout(function () { slide.remove(); }, 380);
      }
      setTimeout(function () {
        btn.classList.remove('is-success');
        btn.disabled = false;
      }, 2000);
    })
    .catch(function (err) {
      console.warn('[Cart Rec ATC]', err);
      btn.classList.remove('is-loading');
      btn.disabled = false;
    });
  }

  /* ────────────────────────────────────────────
     Collection fallback (no Shopify rec signals)
  ──────────────────────────────────────────── */
  function collectionFallback(holder, slider, dotsEl) {
    var handle    = holder.getAttribute('data-collection-handle');
    var cartIds   = (holder.getAttribute('data-cart-ids') || '').split(',').filter(Boolean);
    var btnClasses = holder.getAttribute('data-btn-classes') || '';

    if (!handle) { holder.style.display = 'none'; return; }

    fetch('/collections/' + handle + '/products.json?limit=12')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var products = (data.products || []).filter(function (p) {
          return p.available && cartIds.indexOf(String(p.id)) === -1;
        }).slice(0, 10);

        if (!products.length) { holder.style.display = 'none'; return; }

        products.forEach(function (p) {
          slider.appendChild(buildSlide(p, btnClasses));
        });

        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            if (typeof window.Flickity !== 'undefined') {
              tryFlickity(slider, dotsEl, products.length);
            } else {
              initScrollDots(slider, dotsEl, products.length);
            }
          });
        });
      })
      .catch(function () { holder.style.display = 'none'; });
  }

  function buildSlide(p, btnClasses) {
    var url       = '/products/' + p.handle;
    var rawSrc    = p.images && p.images[0] ? p.images[0].src : '';
    var imgSrc    = rawSrc.replace(/(\.(jpg|jpeg|png|gif|webp))(\?.*)?$/i, '_300x$1');
    var multiVar  = p.variants && p.variants.length > 1;
    var variantId = p.variants && p.variants[0] ? p.variants[0].id : null;

    var imgHtml     = imgSrc ? '<img class="cart-rec__img" src="' + imgSrc + '" alt="' + esc(p.title) + '" loading="lazy" width="300">' : '';
    var variantHtml = multiVar ? '<p class="cart-rec__meta">' + p.variants.length + ' shades</p>' : '';

    var btnHtml;
    if (!multiVar && variantId) {
      btnHtml = '<button type="button" class="cart-rec__btn ' + btnClasses + '" data-variant-id="' + variantId + '" data-add-rec-to-cart>'
              + '<hover-button></hover-button>'
              + '<span class="cart-rec__btn-text">Shop Now</span>'
              + '<svg class="cart-rec__btn-spinner" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="7"></circle></svg>'
              + '</button>';
    } else {
      btnHtml = '<a class="cart-rec__btn ' + btnClasses + '" href="' + url + '">'
              + '<hover-button></hover-button>'
              + '<span class="cart-rec__btn-text">Shop Now</span>'
              + '</a>';
    }

    var slide = document.createElement('div');
    slide.className = 'cart-rec__slide';
    slide.innerHTML = '<a class="cart-rec__image-wrap" href="' + url + '" tabindex="-1" aria-hidden="true">' + imgHtml + '</a>'
                    + '<div class="cart-rec__body">'
                    + '<p class="cart-rec__title"><a href="' + url + '">' + esc(p.title) + '</a></p>'
                    + variantHtml
                    + btnHtml
                    + '</div>';
    return slide;
  }

  function esc(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ── Delegate add-to-cart clicks ── */
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-add-rec-to-cart]');
    if (b) addRecToCart(b);
  });

  /* ── Watch for cart drawer template clone ── */
  document.addEventListener('DOMContentLoaded', function () {
    var drawer = document.querySelector('[data-cart-drawer]');
    if (!drawer) return;

    if (document.getElementById('cartRecommendations')) loadRecommendations();

    new MutationObserver(function () {
      if (document.getElementById('cartRecommendations')) loadRecommendations();
    }).observe(drawer, { childList: true, subtree: true });
  });

  /* ── Re-init after cart update ── */
  document.addEventListener('cart:updated', function () {
    recState.productId = null;
    var holder = document.getElementById('cartRecommendations');
    if (!holder) return;
    var slider = holder.querySelector('[data-rec-slider]');
    var dotsEl = holder.querySelector('[data-rec-dots]');
    if (slider) { try { window.Flickity.data(slider).destroy(); } catch (e) {} slider.innerHTML = ''; }
    if (dotsEl) dotsEl.innerHTML = '';
    holder.style.display = '';
    loadRecommendations();
  });
})();
</script>

